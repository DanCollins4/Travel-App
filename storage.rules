rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Every traveller's files live under /users/{their own uid}/... — nobody
    // else, including other signed-in users, can read or write them.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

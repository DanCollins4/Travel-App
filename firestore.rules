rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every traveller's data lives under /users/{their own uid}/...
    // Nobody — including other signed-in users — can read or write another
    // person's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

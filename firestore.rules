rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every traveller's data lives under /users/{their own uid}/...
    // Nobody — including other signed-in users — can read or write another
    // person's documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public, read-only itinerary snapshots — anyone with the link can view one,
    // but only the signed-in owner (checked via ownerUid on the document) can
    // create, update or delete it.
    match /publicShares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
